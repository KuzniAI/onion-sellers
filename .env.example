# Artificial Analysis API key (https://artificialanalysis.ai/data-api/docs)
# Copy this file to .env and fill in your real key. .env is gitignored.
AA_API_KEY=

# Local-only parser repair: set to 1 to let a Pi agent rewrite a pricing parser that
# fails. Ignored whenever CI or GITHUB_ACTIONS is set.
PARSER_REPAIR=
# Pi model used for repair. Credentials come from Pi itself (`npx pi`, then /login),
# or the provider's API key env var (OPENCODE_API_KEY for opencode-go).
PI_REPAIR_PROVIDER=opencode-go
PI_REPAIR_MODEL=glm-5.3-flash
